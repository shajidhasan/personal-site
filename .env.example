# Cloudflare D1 — only needed for drizzle-kit remote tools (db:push, db:studio).
# Local dev doesn't need these.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

ORIGIN="http://localhost:5173"

# Better Auth — generate with: openssl rand -base64 32
# In production this is a wrangler secret: wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=""

# Set to "true" ONCE to create the single admin account via /api/auth/sign-up/email,
# then remove. Signup is disabled otherwise.
# ALLOW_SIGNUP="true"
