{
	"name": "personal-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:apply:local": "wrangler d1 migrations apply personal-site-db --local",
		"db:apply:remote": "wrangler d1 migrations apply personal-site-db --remote",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"pnpm": {
		"overrides": {
			"cookie": ">=0.7.0",
			"nanoid": ">=3.3.18",
			"postcss": ">=8.5.23"
		}
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/katex": "^0.16.8",
		"@types/node": "^24",
		"@types/nprogress": "^0.2.3",
		"better-auth": "~1.4.21",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-markdown": "^6.5.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.6",
		"@fontsource/space-mono": "^5.2.9",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.24.0",
		"codemirror": "^6.0.2",
		"katex": "^0.17.0",
		"marked": "^18.0.6",
		"marked-shiki": "^1.2.1",
		"nprogress": "^0.2.0",
		"shiki": "^4.3.1",
		"svelte-meta-tags": "^5.0.1",
		"tailwind-scrollbar": "^4.0.2"
	}
}
